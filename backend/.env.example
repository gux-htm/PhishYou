# PhishYou backend environment variables
# Copy this file to .env for local development. Never commit real secrets.

PORT=4000

# LLM configuration. Provider/model/endpoint are free-form values.
# A host-managed LLM_API_KEY takes precedence over a key entered in the UI.
LLM_PROVIDER=gemini
LLM_API_KEY=your-secret-here
LLM_MODEL=gemini-3.7-flash
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions

# Other supported protocol family: OpenAI-compatible chat completions.
# Example endpoint: https://api.provider.example/v1/chat/completions

# Database configuration (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/phishyou
DATABASE_URL=

# ---------------------------------------------------------------------------
# Outbound mail (SMTP) — real delivery via nodemailer.
# Leave SMTP_HOST/SMTP_FROM unset to run in simulated mode (no real sends).
# For Gmail: enable 2FA and use an App Password (not your normal password).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="PhishYou Sim <you@example.com>"
# Mailbox that receives target replies (defaults to SMTP_FROM). Must be the
# mailbox the IMAP watcher below polls.
REPLY_TO=you@example.com

# ---------------------------------------------------------------------------
# Inbound reply monitoring (IMAP poll).
# IMAP_HOST/IMAP_USER/IMAP_PASS fall back to the SMTP_* values if omitted.
# ---------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@example.com
IMAP_PASS=your-app-password
IMAP_MAILBOX=INBOX
MAIL_POLL_INTERVAL_MS=15000
