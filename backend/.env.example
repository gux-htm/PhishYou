# PhishYou backend environment variables
# setup.sh creates backend/.env from this template. Never commit real secrets.

PORT=4000

# Leave LLM values empty. Configure them after registration from Tool Settings.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_ENDPOINT=

# PhishYou uses SQLite by default. No DATABASE_URL is required for local setup.
DATABASE_URL=

# Email connector is configured from Tool Settings. Blank values keep local email simulation disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPLY_TO=

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
MAIL_POLL_INTERVAL_MS=15000
