# PhishYou backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000

# LLM provider configuration
LLM_PROVIDER=qwen
LLM_API_KEY=sk-your-dashscope-key-here
LLM_MODEL=qwen-max
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# Database configuration (optional — can also be configured in the UI)
# DATABASE_URL=postgresql://user:password@localhost:5432/phishyou
DATABASE_URL=
